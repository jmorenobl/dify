# ==========================================
# DOKPLOY / TRAEFIK CONFIGURATION
# ==========================================

# Your custom domain (WITHOUT http/https)
# This is used by Traefik to route traffic.
# Example: agentdemo.aibuildr.tech
DIFY_DOMAIN=

# Full URLs for the application services (WITH https:// if SSL is enabled)
# Usually all point to the same domain in a Dokploy setup.
# Example: https://agentdemo.aibuildr.tech
CONSOLE_API_URL=
SERVICE_API_URL=
APP_API_URL=
APP_WEB_URL=

# ==========================================
# SECURITY & CORS (Required for HTTPS/SSL)
# ==========================================

# Explicitly allow your domain for CORS to permit credentials/cookies
# Must match the URL used in browser (WITH https://)
# Example: https://agentdemo.aibuildr.tech
WEB_API_CORS_ALLOW_ORIGINS=
CONSOLE_CORS_ALLOW_ORIGINS=

# Cookie configuration for secure sessions
# Recommended: .yourdomain.com (note the leading dot to include subdomains)
# Example: .aibuildr.tech
COOKIE_DOMAIN=
NEXT_PUBLIC_COOKIE_DOMAIN=

# ==========================================
# STANDARD DIFY CONFIGURATION
# ==========================================
# (Copy rest of standard variables here or keep them in Dokploy UI)
